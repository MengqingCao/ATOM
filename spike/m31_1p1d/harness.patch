--- a/bin/run_pd.sh	2026-11-25 03:39:18.102945859 +0000
+++ b/bin/run_pd.sh	2026-11-25 07:54:23.026199264 +0000
@@ -31,8 +31,9 @@
 BASE="${H}/runs"
 SNAP="${H}/src/${TAG}-${STAMP}"
 mkdir -p "${H}/src" "${BASE}"
-snap_sha="$(git -C "${TREE}" stash create)"
-snap_sha="${snap_sha:-$(git -C "${TREE}" rev-parse HEAD)}"
+# The snapshot is TREE's HEAD; a dirty TREE is refused (no stash).
+[[ -z "$(git -C "${TREE}" status --porcelain --untracked-files=no)" ]] || { echo "TREE ${TREE} is dirty" >&2; exit 2; }
+snap_sha="$(git -C "${TREE}" rev-parse HEAD)"
 git -C "${TREE}" worktree add --detach "${SNAP}" "${snap_sha}" > /dev/null
 echo "snapshot ${snap_sha} of ${TREE} -> ${SNAP}"
 cd "${SNAP}"
